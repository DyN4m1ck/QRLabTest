<Styles xmlns="https://github.com/avaloniaui" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="using:QRLab.View.Controls"
        xmlns:converters="using:QRLab.View.Converters">
  <!-- Style cfg for Avalonia UI -->
  
  <Styles.Resources>
    <converters:IconNameConverter x:Key="IconName"/>
    <SolidColorBrush x:Key="ActiveIconBrush">#75D9BE</SolidColorBrush>
    <SolidColorBrush x:Key="InactiveIconBrush">#86928F</SolidColorBrush>
    <Color x:Key="SystemAccentColor">#75D9BE</Color>
    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush">#75D9BE</SolidColorBrush>
  </Styles.Resources>
  
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="fonts:Inter#Inter"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Background" Value="#111516"/>
    <Setter Property="Foreground" Value="#DFE6E4"/>
  </Style>
  
  <Style Selector="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="#86928F"/>
    <Setter Property="FontSize" Value="11"/>
  </Style>
  
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="#9DA9A5"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Margin" Value="0,5,0,3"/>
  </Style>
  
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Consolas"/>
  </Style>
  
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="#75D9BE"/>
    
  </Style>
  
  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="#E58A86"/>
  </Style>
  
  <Style Selector="Border.card">
    <Setter Property="Background" Value="#1B2022"/>
    <Setter Property="BorderBrush" Value="#303839"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="5"/>
  </Style>
  
  <Style Selector="Border.panelHead">
    <Setter Property="Padding" Value="14,12"/>
    <Setter Property="BorderBrush" Value="#303839"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Background" Value="#303839"/>
    <Setter Property="Margin" Value="0,12"/>
  </Style>
  
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Background" Value="#282F32"/>
  </Style>
  
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="#75D9BE"/>
    <Setter Property="Foreground" Value="#113E34"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#98E9D2"/>
    <Setter Property="Foreground" Value="#113E34"/>
  </Style>
  
  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  
  <Style Selector="ComboBox">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Background" Value="#151A1C"/>
  </Style>
  
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Background" Value="#151A1C"/>
  </Style>
  
  <Style Selector="NumericUpDown">
    <Setter Property="ShowButtonSpinner" Value="False"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Background" Value="#151A1C"/>
  </Style>
  
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="Margin" Value="0,0,0,1"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="#24483F"/>
  </Style>
  
  <Style Selector="ListBox.tabs">
    <Setter Property="Height" Value="38"/>
  </Style>
  
  <Style Selector="ListBox.tabs ListBoxItem">
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="CornerRadius" Value="3"/>
  </Style>
  
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="22,12"/>
    <Setter Property="MinWidth" Value="170"/>
  </Style>
  
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="#1D2927"/>
    <Setter Property="BorderBrush" Value="#75D9BE"/>
    <Setter Property="BorderThickness" Value="0,2,0,0"/>
  </Style>
  
  <Style Selector="Slider">
    <Setter Property="MinWidth" Value="40"/>
    <Setter Property="MinHeight" Value="20"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Slider:horizontal /template/ Border#TrackBackground">
    <Setter Property="Height" Value="4"/>
    <Setter Property="CornerRadius" Value="2"/>
  </Style>

  <Style Selector="Slider /template/ Thumb">
    <Setter Property="Width" Value="10"/>
    <Setter Property="Height" Value="10"/>
  </Style>
  
  <Style Selector="icons|SvgIcon">
    <Setter Property="Width" Value="15"/>
    <Setter Property="Height" Value="15"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
  
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource InactiveIconBrush}"/>
  </Style>
  
  <Style Selector="ListBox.nav ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource ActiveIconBrush}"/>
  </Style>
  
  <Style Selector="ListBox.nav ListBoxItem TextBlock">
    <Setter Property="Foreground" Value="{Binding $parent[ListBoxItem].Foreground}"/>
  </Style>
  
  <Style Selector="ListBox.nav ListBoxItem icons|SvgIcon">
    <Setter Property="Foreground" Value="{Binding $parent[ListBoxItem].Foreground}"/>
  </Style>
  
  <Style Selector="ListBox.iconTabs ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource InactiveIconBrush}"/>
  </Style>
  
  <Style Selector="ListBox.iconTabs ListBoxItem TextBlock">
    <Setter Property="Foreground" Value="{Binding $parent[ListBoxItem].Foreground}"/>
  </Style>
  
  <Style Selector="ListBox.iconTabs ListBoxItem icons|SvgIcon">
    <Setter Property="Foreground" Value="{Binding $parent[ListBoxItem].Foreground}"/>
  </Style>
  
  <Style Selector="ListBox.iconTabs ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource ActiveIconBrush}"/>
  </Style>
  
  <Style Selector="ListBox.tools">
    <Setter Property="Height" Value="62"/>
  </Style>
  
  <Style Selector="ListBox.tools ListBoxItem">
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="MinWidth" Value="60"/>
  </Style>
</Styles>
