<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:QRLab.View.ViewModels" xmlns:c="using:QRLab.View.Controls" xmlns:core="using:QRLab.Core.Services" xmlns:icons="using:QRLab.View.Controls" x:Class="QRLab.View.Views.GenerationView" x:DataType="vm:GenerationViewModel">
  <Grid Margin="18" RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Description}" Classes="muted"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Command="{Binding OpenLibraryCommand}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <icons:SvgIcon Source="folder"/>
            <TextBlock Text="Открыть набор"/>
          </StackPanel>
        </Button>
        <Button Command="{Binding ExportCommand}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <icons:SvgIcon Source="load"/>
            <TextBlock Text="Экспорт набора"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="250,*,260" ColumnSpacing="12">
      <Border Classes="card">
        <Grid RowDefinitions="Auto,*,Auto">
          <Border Classes="panelHead">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <icons:SvgIcon Source="config"/>
              <TextBlock Text="Параметры генерации" Classes="heading"/>
            </StackPanel>
          </Border>
          <ScrollViewer Grid.Row="1">
            <StackPanel Margin="14" Spacing="5">
              <ListBox Classes="tabs" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode, Mode=TwoWay}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>
              <TextBlock Text="Тип кода" Classes="label"/>
              <ListBox Classes="tabs iconTabs" ItemsSource="{Binding Formats}" SelectedItem="{Binding Format, Mode=TwoWay}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <icons:SvgIcon Source="{Binding Converter={StaticResource IconName}}"/>
                      <TextBlock Text="{Binding}"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              
              <TextBlock Text="Источник содержимого" Classes="label"/>
              <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source, Mode=TwoWay}"/>
              <TextBlock Text="Содержимое / шаблон" Classes="label"/>
              <TextBox Text="{Binding Template, Mode=TwoWay}" AcceptsReturn="True" Height="62" TextWrapping="Wrap"/>
              <TextBlock Text="{}{num} — порядковый номер образца" Classes="muted" FontSize="10"/>
              
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsBatch}">
                <StackPanel>
                  <TextBlock Text="Первый номер" Classes="label"/>
                  <NumericUpDown Value="{Binding FirstNumber, Mode=TwoWay}" Minimum="1" Maximum="999999" FormatString="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Количество" Classes="label"/>
                  <NumericUpDown Value="{Binding Count, Mode=TwoWay}" Minimum="1" Maximum="500" FormatString="0"/>
                </StackPanel>
              </Grid>
              
              <Border Classes="divider"/>
              
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <StackPanel>
                  <TextBlock Text="Ширина, пикс." Classes="label"/>
                  <NumericUpDown Value="{Binding ImageWidth, Mode=TwoWay}" Minimum="128" Maximum="8192" FormatString="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Высота, пикс." Classes="label"/>
                  <NumericUpDown Value="{Binding ImageHeight, Mode=TwoWay}" Minimum="128" Maximum="8192" FormatString="0"/>
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Формат файла" Classes="label"/>
                  <ComboBox ItemsSource="{Binding FileFormats}" SelectedItem="{Binding FileFormat, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" IsVisible="{Binding IsQr}">
                  <TextBlock Text="Коррекция QR" Classes="label"/>
                  <ComboBox ItemsSource="{Binding Corrections}" SelectedItem="{Binding Correction, Mode=TwoWay}"/>
                </StackPanel>
              </Grid>
              <StackPanel>
                <TextBlock Text="Тихая зона, модулей" Classes="label"/>
                <NumericUpDown Value="{Binding QuietZone, Mode=TwoWay}" Minimum="0" Maximum="16" FormatString="0"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Margin="14" Spacing="8">
            <Button Classes="primary" Command="{Binding GenerateCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,12,0,0">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <icons:SvgIcon Source="plus"/>
                <TextBlock Text="{Binding GenerateLabel}"/>
              </StackPanel>
            </Button>
            <TextBlock Text="Параметры будут применены к новому набору." Classes="muted" FontSize="10" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1" RowDefinitions="*,170" RowSpacing="12">
        <Border Classes="card" ClipToBounds="True">
          <Grid RowDefinitions="Auto,*,52">
            <Border Classes="panelHead">
              <TextBlock Text="Предпросмотр" Classes="heading"/>
            </Border>
            <Border Grid.Row="1" Background="#0D1112" Padding="30">
              <c:CodePreview Modules="{Binding Workspace.SelectedSample.Modules}" AllowZoom="True"/>
            </Border>
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" Margin="14,0">
              <TextBlock Text="{Binding Workspace.SelectedSample.Name}" Classes="mono"/>
              <Button Grid.Column="1" Classes="flat" Command="{Binding Workspace.PreviousCommand}" ToolTip.Tip="Предыдущий образец">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <icons:SvgIcon Source="arrow-right" Width="12" Height="12" RenderTransform="rotate(180deg)" RenderTransformOrigin="50%,50%"/>
                </StackPanel>
              </Button>
              <TextBlock Grid.Column="2" Text="{Binding Workspace.Position}" Classes="muted" Margin="10,0"/>
              <Button Grid.Column="3" Classes="flat" Command="{Binding Workspace.NextCommand}" ToolTip.Tip="Следующий образец">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <icons:SvgIcon Source="arrow-right" Width="12" Height="12"/>
                </StackPanel>
              </Button>
            </Grid>
          </Grid>
        </Border>
        <Border Grid.Row="1" Classes="card">
          <StackPanel Margin="16" Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Содержимое образца" Classes="heading"/>
              <TextBlock Grid.Column="1" Text="Готов к мутациям" Classes="accent" FontSize="10"/>
            </Grid>
            <TextBlock Text="{Binding Workspace.SelectedSample.Content}" FontSize="20" Classes="mono"/>
            <StackPanel Orientation="Horizontal" Spacing="18">
              <TextBlock Text="{Binding Workspace.SelectedSample.Format}" Classes="muted"/>
              <TextBlock Text="{Binding Workspace.SelectedSample.Dimensions}" Classes="muted"/>
              <TextBlock Text="{Binding FileFormat}" Classes="muted"/>
            </StackPanel>
            <TextBlock Text="Исходник защищён. Изменения образуют отдельную цепочку кадров." Classes="muted" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Grid>
      <Border Grid.Column="2" Classes="card">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <Border Classes="panelHead">
            <TextBlock Text="Пакетная очередь" Classes="heading"/>
          </Border>
          <StackPanel Grid.Row="1" Margin="14" Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Набор 01" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="1" Text="Подготовлен" Classes="accent" FontSize="10"/>
            </Grid>
            <ProgressBar Minimum="0" Maximum="1" Value="1" Height="3" Foreground="#75D9BE"/>
            <TextBlock Text="Демонстрационные образцы" Classes="muted"/>
          </StackPanel>
          <ListBox Grid.Row="2" ItemsSource="{Binding Workspace.Samples}" SelectedItem="{Binding Workspace.SelectedSample, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SampleViewModel">
                <Grid ColumnDefinitions="34,*,Auto" ColumnSpacing="10">
                  <c:CodePreview Modules="{Binding Modules}" Width="32" Height="32"/>
                  <StackPanel Spacing="3" Grid.Column="1">
                    <TextBlock Text="{Binding Name}" Classes="mono" FontSize="11"/>
                    <TextBlock Text="{Binding Content}" Classes="muted" FontSize="10"/>
                  </StackPanel>
                  <icons:SvgIcon Source="ok" Foreground="#75D9BE" Grid.Column="2"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="3" Margin="14" Spacing="10">
            <TextBlock Text="{Binding Workspace.Position}" Classes="muted"/>
            <Button Classes="primary" Command="{ReflectionBinding $parent[Window].DataContext.NavigateCommand}" CommandParameter="02" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <icons:SvgIcon Source="arrow-right"/>
                <TextBlock Text="Перейти к мутациям"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.RowSpan="2" Background="#DD0B1011" IsVisible="{Binding IsLibraryOpen}">
      <Border Classes="card" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
        <StackPanel Spacing="16">
          <TextBlock Text="Открыть демонстрационный набор" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="Выберите набор из библиотеки проекта." Classes="muted" TextWrapping="Wrap"/>
          <ItemsControl ItemsSource="{Binding Workspace.LibrarySets}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:LibrarySet">
                <Button Content="{Binding Name}" Command="{ReflectionBinding $parent[UserControl].DataContext.LoadSetCommand}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" Margin="0,4"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Закрыть" Command="{Binding OpenLibraryCommand}"/>
        </StackPanel>
      </Border>
    </Border>
    <Border Grid.RowSpan="2" Background="#DD0B1011" IsVisible="{Binding IsExportOpen}">
      <Border Classes="card" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
        <StackPanel Spacing="16">
          <TextBlock Text="Экспорт набора" FontSize="20"/>
          <TextBlock Text="Параметры экспорта" Classes="muted"/>
          <ComboBox ItemsSource="{Binding FileFormats}" SelectedItem="{Binding FileFormat, Mode=TwoWay}"/>
          <TextBlock Text="Папка назначения" Classes="label"/>
          <TextBox Text="{Binding ExportDestination, Mode=TwoWay}"/>
          <CheckBox Content="Включить параметры и метаданные" IsChecked="{Binding IncludeMetadata, Mode=TwoWay}" FontSize="11"/>
          <TextBlock Text="Экспортировать все образцы текущего набора с выбранными настройками." Classes="muted" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Отмена" Command="{Binding ExportCommand}"/>
            <Button Classes="primary" Command="{Binding ConfirmExportCommand}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <icons:SvgIcon Source="load"/>
                <TextBlock Text="Экспортировать"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
