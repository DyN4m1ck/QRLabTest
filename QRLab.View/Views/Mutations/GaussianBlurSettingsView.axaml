<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QRLab.View.ViewModels" xmlns:local="using:QRLab.View.Views.Mutations"
             xmlns:p="using:QRLab.View.Presentation" x:Class="QRLab.View.Views.Mutations.GaussianBlurSettingsView"
             x:DataType="vm:MutationsViewModel">
  <StackPanel>
    <local:NumericMutationParameter Label="Сила размытия, σ" Value="{Binding Blur, Mode=TwoWay}" Minimum="0" Maximum="50"/>
  </StackPanel>
</UserControl>
