<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QRLab.View.ViewModels" xmlns:c="using:QRLab.View.Controls"
             xmlns:p="using:QRLab.View.Presentation" x:Class="QRLab.View.Views.MutationsView" x:DataType="vm:MutationsViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="MutationChoiceTemplate" x:DataType="p:EnumOption"><TextBlock Text="{Binding Name}"/></DataTemplate>
  </UserControl.Resources>
  <Grid Margin="18" RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Description}" Classes="muted"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="Отменить" Command="{Binding UndoCommand}"/>
        <Button Content="Повторить" Command="{Binding RedoCommand}"/>
        <Button Classes="primary" Content="Применить к набору" Command="{Binding ApplyCommand}"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="230,*,260" ColumnSpacing="12">
      <Border Classes="card">
        <StackPanel>
          <Border Classes="panelHead"><TextBlock Text="Алгоритмические искажения" Classes="heading"/></Border>
          <StackPanel Margin="14" Spacing="12">
            <ItemsControl ItemsSource="{Binding AvailableMutations}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="p:EnumOption">
                  <Button Command="{ReflectionBinding $parent[UserControl].DataContext.AddCommand}" CommandParameter="{Binding Value}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                      <c:SvgIcon Source="{Binding Icon}"/><TextBlock Grid.Column="1" Text="{Binding Name}"/>
                      <c:SvgIcon Grid.Column="2" Source="plus" Width="12" Height="12"/>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Добавьте искажение и задайте параметры справа. Каждый кадр использует результат предыдущего." Classes="muted" TextWrapping="Wrap"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Grid Grid.Column="1" RowDefinitions="*,170" RowSpacing="12">
        <Border Classes="card">
          <Grid RowDefinitions="Auto,*,42">
            <Border Classes="panelHead">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding Workspace.SelectedSample.Name}" Classes="accent"/>
                <TextBlock Grid.Column="1" Text="{Binding SelectedFrame.Name}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5">
                  <Button Content="‹" Command="{Binding Workspace.PreviousCommand}" ToolTip.Tip="Предыдущий образец"/>
                  <NumericUpDown x:Name="SampleNumberInput" Value="{Binding Workspace.SampleNumber, Mode=TwoWay}"
                      Minimum="1" Maximum="{Binding Workspace.SampleNumberMaximum}" FormatString="0" Width="78"/>
                  <TextBlock Text="/" Classes="muted"/><TextBlock Text="{Binding Workspace.SampleCount}" Classes="muted"/>
                  <Button Content="›" Command="{Binding Workspace.NextCommand}" ToolTip.Tip="Следующий образец"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Grid.Row="1" Background="#0D1112" Padding="30">
              <c:RasterPreview x:Name="MutationPreview" Image="{Binding PreviewImage}" AllowZoom="True"/>
            </Border>
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="14,0">
              <TextBlock Text="ЛКМ — перемещение  •  Колесо — масштаб" Classes="muted" FontSize="10"/>
              <Button x:Name="ResetMutationViewport" Grid.Column="1" Content="Сбросить вид" Classes="flat" Command="{Binding #MutationPreview.ResetViewCommand}"/>
            </Grid>
          </Grid>
        </Border>
        <Border Grid.Row="1" Classes="card">
          <Grid RowDefinitions="Auto,*">
            <Border Classes="panelHead"><TextBlock Text="Промежуточные кадры" Classes="heading"/></Border>
            <ListBox Grid.Row="1" ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame, Mode=TwoWay}">
              <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:OperationViewModel">
                  <StackPanel Width="105" Spacing="6">
                    <c:RasterPreview Height="70" Image="{Binding Image}"/>
                    <TextBlock Text="{Binding Name}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Number}" Classes="muted" FontSize="9"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Column="2" Classes="card">
        <Grid RowDefinitions="Auto,200,*">
          <Border Classes="panelHead"><TextBlock Text="Последовательность операций" Classes="heading"/></Border>
          <ListBox Grid.Row="1" ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:OperationViewModel">
                <Grid ColumnDefinitions="24,*">
                  <TextBlock Text="{Binding Number}" Classes="accent" FontSize="10"/>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{Binding Name}" FontSize="12"/>
                    <TextBlock Text="{Binding Details}" Classes="muted" FontSize="10" TextWrapping="Wrap"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <ScrollViewer Grid.Row="2">
            <StackPanel Margin="14" Spacing="8">
              <TextBlock Text="Параметры операции" Classes="heading"/>
              <StackPanel IsVisible="{Binding IsPerspective}" Spacing="5">
                <TextBlock Text="Наклон по X, °" Classes="label"/>
                <Slider Minimum="-60" Maximum="60" Value="{Binding AngleX, Mode=TwoWay}"/>
                <TextBlock Text="{Binding AngleX, StringFormat={}{0:N1}°}" Classes="muted"/>
                <TextBlock Text="Наклон по Y, °" Classes="label"/>
                <Slider Minimum="-60" Maximum="60" Value="{Binding AngleY, Mode=TwoWay}"/>
                <TextBlock Text="{Binding AngleY, StringFormat={}{0:N1}°}" Classes="muted"/>
                <TextBlock Text="Дистанция проекции" Classes="label"/>
                <Slider Minimum="1" Maximum="10" Value="{Binding Distance, Mode=TwoWay}"/>
                <TextBlock Text="{Binding Distance, StringFormat={}{0:N1}}" Classes="muted"/>
                <TextBlock Text="Интерполяция" Classes="label"/>
                <ComboBox ItemsSource="{Binding Interpolations}" ItemTemplate="{StaticResource MutationChoiceTemplate}"
                    SelectedValue="{Binding Interpolation, Mode=TwoWay}" SelectedValueBinding="{Binding Value, DataType=p:EnumOption}"/>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsBlur}" Spacing="5">
                <TextBlock Text="Сила размытия, σ" Classes="label"/>
                <Slider Minimum="0" Maximum="50" Value="{Binding Blur, Mode=TwoWay}"/>
                <TextBlock Text="{Binding Blur, StringFormat={}{0:N1} px}" Classes="muted"/>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsSaltAndPepper}" Spacing="5">
                <TextBlock Text="Плотность шума, %" Classes="label"/>
                <Slider Minimum="0" Maximum="100" Value="{Binding NoiseDensity, Mode=TwoWay}"/>
                <TextBlock Text="{Binding NoiseDensity, StringFormat={}{0:N1}%}" Classes="muted"/>
                <TextBlock Text="Доля белых точек, %" Classes="label"/>
                <Slider Minimum="0" Maximum="100" Value="{Binding SaltPercent, Mode=TwoWay}"/>
                <TextBlock Text="{Binding SaltPercent, StringFormat={}{0:N1}%}" Classes="muted"/>
                <TextBlock Text="Seed" Classes="label"/>
                <NumericUpDown Value="{Binding Seed, Mode=TwoWay}" Minimum="0" Maximum="2147483647" FormatString="0"/>
                <Button Content="Новый seed" Command="{Binding RandomizeCommand}"/>
              </StackPanel>
              <Border Classes="divider"/>
              <TextBlock Text="Исходник защищён" Classes="accent" FontSize="11"/>
              <Button Content="Сбросить цепочку" Command="{Binding ResetCommand}" HorizontalAlignment="Stretch"/>
              <Button Content="К распознаванию" Command="{ReflectionBinding $parent[Window].DataContext.NavigateCommand}" CommandParameter="03" HorizontalAlignment="Stretch"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="650" Margin="16" Padding="14"
            Background="#492B2B" CornerRadius="8" IsVisible="{Binding Workspace.HasError}">
      <TextBlock Text="{Binding Workspace.Error}" Foreground="#FFB4AB" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</UserControl>