<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:QRLab.View.ViewModels" xmlns:c="using:QRLab.View.Controls" xmlns:icons="using:QRLab.View.Controls" xmlns:m="clr-namespace:QRLab.Core.Models.Mutations;assembly=QRLab.Core" xmlns:p="using:QRLab.View.Presentation" x:Class="QRLab.View.Views.MutationsView" x:DataType="vm:MutationsViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="MutationChoiceTemplate" x:DataType="p:EnumOption">
      <TextBlock Text="{Binding Name}"/>
    </DataTemplate>
  </UserControl.Resources>
  <Grid Margin="18" RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Description}" Classes="muted"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Command="{Binding UndoCommand}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <icons:SvgIcon Source="undo"/>
            <TextBlock Text="Отменить"/>
          </StackPanel>
        </Button>
        <Button Command="{Binding RedoCommand}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <icons:SvgIcon Source="redo"/>
            <TextBlock Text="Повторить"/>
          </StackPanel>
        </Button>
        <Button Classes="primary" Command="{Binding ApplyCommand}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <icons:SvgIcon Source="layers"/>
            <TextBlock Text="Применить к набору"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="230,*,260" ColumnSpacing="12">
      <Border Classes="card">
        <Grid RowDefinitions="Auto,*">
          <Border Classes="panelHead">
            <TextBlock Text="Инструменты" Classes="heading"/>
          </Border>
          <ScrollViewer Grid.Row="1">
            <StackPanel Margin="14" Spacing="8">
              <ListBox Classes="tabs" ItemsSource="{Binding Modes}" ItemTemplate="{StaticResource MutationChoiceTemplate}" SelectedValue="{Binding Mode, Mode=TwoWay}" SelectedValueBinding="{Binding Value, DataType=p:EnumOption}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>
              <ListBox Classes="tabs iconTabs tools" ItemsSource="{Binding Tools}" SelectedValue="{Binding Tool, Mode=TwoWay}" SelectedValueBinding="{Binding Value, DataType=p:EnumOption}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="p:EnumOption">
                    <StackPanel Spacing="4">
                      <icons:SvgIcon Source="{Binding Icon}" HorizontalAlignment="Center"/>
                      <TextBlock Text="{Binding Name}"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Диаметр кисти" Classes="label"/>
                <TextBlock Grid.Column="1" Text="{Binding BrushSize, StringFormat={}{0:N0} px}" Classes="muted"/>
              </Grid>
              <Slider Minimum="8" Maximum="120" Value="{Binding BrushSize, Mode=TwoWay}"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Непрозрачность" Classes="label"/>
                <TextBlock Grid.Column="1" Text="{Binding Opacity, StringFormat={}{0:N0}%}" Classes="muted"/>
              </Grid>
              <Slider Minimum="5" Maximum="100" Value="{Binding Opacity, Mode=TwoWay}"/>
              <TextBlock Text="Цвет кисти                     ●  #111918" Classes="muted"/>
              <Button IsEnabled="{Binding IsManual}" Command="{Binding AddCommand}" CommandParameter="{x:Static m:MutationKind.Ink}" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <icons:SvgIcon Source="plus"/>
                  <TextBlock Text="Добавить мазок"/>
                </StackPanel>
              </Button>
              <Border Classes="divider"/>
              <TextBlock Text="Программные искажения" Classes="heading"/>
              <Button Command="{Binding AddCommand}" CommandParameter="{x:Static m:MutationKind.GaussianBlur}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <icons:SvgIcon Source="drop"/>
                  <TextBlock Text="Размытие Гаусса" Grid.Column="1"/>
                  <icons:SvgIcon Source="plus" Grid.Column="2" Width="12" Height="12"/>
                </Grid>
              </Button>
              <Button Command="{Binding AddCommand}" CommandParameter="{x:Static m:MutationKind.Ink}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <icons:SvgIcon Source="droplets"/>
                  <TextBlock Text="Случайные кляксы" Grid.Column="1"/>
                  <icons:SvgIcon Source="plus" Grid.Column="2" Width="12" Height="12"/>
                </Grid>
              </Button>
              <Button Command="{Binding AddCommand}" CommandParameter="{x:Static m:MutationKind.Perspective}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <icons:SvgIcon Source="selection"/>
                  <TextBlock Text="Перспектива" Grid.Column="1"/>
                  <icons:SvgIcon Source="plus" Grid.Column="2" Width="12" Height="12"/>
                </Grid>
              </Button>
              <Border Classes="divider"/>
              <TextBlock Text="Контроль случайности" Classes="heading"/>
              <TextBlock Text="Зерно генератора" Classes="label"/>
              <NumericUpDown Value="{Binding Seed, Mode=TwoWay}" Minimum="1" Maximum="999999" FormatString="0"/>
              <Button Command="{Binding RandomizeCommand}" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <icons:SvgIcon Source="shuffle"/>
                  <TextBlock Text="Новый случайный вариант"/>
                </StackPanel>
              </Button>
              <TextBlock Text="Работает гауссово размытие. Кляксы и перспектива пока не изменяют изображение. Выберите кадр для настройки." Classes="muted" FontSize="10" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
      <Grid Grid.Column="1" RowDefinitions="*,170" RowSpacing="12">
        <Border Classes="card">
          <Grid RowDefinitions="Auto,*,34">
            <Border Classes="panelHead">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="{Binding Workspace.SelectedSample.Name}" Classes="accent"/>
                <TextBlock Grid.Column="1" Text="{Binding SelectedOperation.Name}" Margin="14,0" Classes="muted"/>
                <TextBlock Grid.Column="2" Text="ПРЕВЬЮ" Classes="muted" FontSize="10"/>
              </Grid>
            </Border>
            <Border Grid.Row="1" Background="#0D1112" Padding="30">
              <c:RasterPreview Image="{Binding PreviewImage}" AllowZoom="True" PaintCommand="{Binding PaintCommand}" PanEnabled="{Binding IsHand}"/>
            </Border>
            <TextBlock Grid.Row="2" Text="Клик — мазок  •  Рука — перемещение  •  Колесо — масштаб" Classes="muted" FontSize="10" Margin="14,0"/>
          </Grid>
        </Border>
        <Border Grid.Row="1" Classes="card">
          <Grid RowDefinitions="Auto,*">
            <Border Classes="panelHead">
              <TextBlock Text="Промежуточные кадры" Classes="heading"/>
            </Border>
            <ListBox Grid.Row="1" ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame, Mode=TwoWay}" HorizontalAlignment="Stretch">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:OperationViewModel">
                  <StackPanel Width="105" Spacing="6">
                    <c:RasterPreview Height="70" Image="{Binding Image}"/>
                    <TextBlock Text="{Binding Name}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Number}" Classes="muted" FontSize="9"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Column="2" Classes="card">
        <Grid RowDefinitions="Auto,220,*">
          <Border Classes="panelHead">
            <TextBlock Text="Последовательность операций" Classes="heading"/>
          </Border>
          <ListBox Grid.Row="1" ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:OperationViewModel">
                <Grid ColumnDefinitions="24,*">
                  <TextBlock Text="{Binding Number}" Classes="accent" FontSize="10"/>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{Binding Name}" FontSize="12"/>
                    <TextBlock Text="{Binding Details}" Classes="muted" FontSize="10"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <ScrollViewer Grid.Row="2">
            <StackPanel Margin="14" Spacing="8">
              <Border Classes="divider"/>
              <StackPanel Orientation="Horizontal" Spacing="7">
                <icons:SvgIcon Source="config"/>
                <TextBlock Text="Параметры операции" Classes="heading"/>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsPerspective}">
                <TextBlock Text="Наклон по X" Classes="label"/>
                <Slider Minimum="-30" Maximum="30" Value="{Binding AngleX, Mode=TwoWay}"/>
                <TextBlock Text="{Binding AngleX, StringFormat={}{0:N0}°}" Classes="muted"/>
                <TextBlock Text="Наклон по Y" Classes="label"/>
                <Slider Minimum="-30" Maximum="30" Value="{Binding AngleY, Mode=TwoWay}"/>
                <ComboBox ItemsSource="{Binding Interpolations}" ItemTemplate="{StaticResource MutationChoiceTemplate}" SelectedValue="{Binding Interpolation, Mode=TwoWay}" SelectedValueBinding="{Binding Value, DataType=p:EnumOption}"/>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsBlur}">
                <TextBlock Text="Сила размытия, σ" Classes="label"/>
                <Slider Minimum="0" Maximum="10" Value="{Binding Blur, Mode=TwoWay}"/>
                <TextBlock Text="{Binding Blur, StringFormat={}{0:N1} px}" Classes="muted"/>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsInk}">
                <TextBlock Text="Параметры кисти находятся слева. Добавьте мазок для нового этапа." Classes="muted" TextWrapping="Wrap"/>
              </StackPanel>
              <Border Classes="divider"/>
              <TextBlock Text="Область изменения   Всё изображение" Classes="muted"/>
              <StackPanel Orientation="Horizontal" Spacing="7">
                <icons:SvgIcon Source="lock" Foreground="{DynamicResource ActiveIconBrush}" Width="12" Height="12"/>
                <TextBlock Text="Исходник защищён" Classes="accent" FontSize="11"/>
              </StackPanel>
              <Button Command="{Binding ResetCommand}" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <icons:SvgIcon Source="reload"/>
                  <TextBlock Text="Сбросить цепочку"/>
                </StackPanel>
              </Button>
              <Button Command="{ReflectionBinding $parent[Window].DataContext.NavigateCommand}" CommandParameter="03" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <icons:SvgIcon Source="arrow-right"/>
                  <TextBlock Text="К распознаванию"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
